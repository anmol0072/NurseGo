{
  "expo": {
    "name": "NurseGo",
    "slug": "nursenow-app",
    "scheme": "nursego",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_padded.png",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nursego.official",
      "config": {
        "googleMapsApiKey": "AIzaSyD0zm_7Fy1g-MJ7UVZKvkjQfM_c3BTacX8"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo_padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nursego.official",
      "versionCode": 4,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0zm_7Fy1g-MJ7UVZKvkjQfM_c3BTacX8"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NurseGo to access your camera to take profile photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NurseGo to access your photos to upload documents."
        }
      ],
      [
        "expo-document-picker",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f10bd484-5d1a-45a1-8284-42cc423c5bfe"
      }
    }
  }
}
