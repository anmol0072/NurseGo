{
  "expo": {
    "name": "NurseNow",
    "slug": "nursenow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nursenow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.jpeg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nursenow.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NurseGo to access your camera for consultations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NurseGo to access your photos for wound images."
        }
      ],
      [
        "expo-document-picker",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9fba579f-e33c-429f-81fc-57b9b777fcc0"
      }
    }
  }
}
